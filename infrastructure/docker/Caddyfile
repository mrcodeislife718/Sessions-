{$SESSIONS_DOMAIN:localhost} {
  encode zstd gzip

  @authenticatedReady {
    path /ready
    header Authorization *
  }
  handle @authenticatedReady {
    rewrite * /api/sessions
    reverse_proxy api:4000
  }

  @auth path /api/auth/*
  handle @auth {
    reverse_proxy auth:4200
  }

  @billing path /api/billing/* /api/account/* /webhooks/stripe
  handle @billing {
    reverse_proxy billing:4100
  }

  @api path /api/* /health /ready
  handle @api {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy web:3000
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
