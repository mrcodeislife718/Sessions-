{$SESSIONS_DOMAIN:localhost} {
  encode zstd gzip

  @authenticatedReady {
    path /ready
    header Authorization *
  }
  handle @authenticatedReady {
    rewrite * /api/sessions
    reverse_proxy api:4000
  }

  @auth path /api/auth/*
  handle @auth {
    reverse_proxy auth:4200
  }

  # Repository administration and legacy migration are isolated behind the
  # repository control service. Normal native repository data paths remain on
  # the first-party Sessions API.
  @repositoryControl path_regexp repositoryControl ^/api/repositories/[^/]+/(git-import|branch-policies(?:/.*)?|environment-policies(?:/.*)?|deployments/[^/]+/(approvals|status))$
  handle @repositoryControl {
    reverse_proxy repositories:4300
  }

  @webhookControl path_regexp webhookControl ^/api/repositories/[^/]+/webhooks(?:/.*)?$
  handle @webhookControl {
    reverse_proxy webhooks:4500
  }

  @workflowControl path_regexp workflowControl ^/api/repositories/[^/]+/(workflows(?:/.*)?|action-runs/[^/]+)$
  handle @workflowControl {
    reverse_proxy workflows:4400
  }

  @billing path /api/billing/* /api/account/* /webhooks/stripe
  handle @billing {
    reverse_proxy billing:4100
  }

  @api path /api/* /health /ready
  handle @api {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy web:3000
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
