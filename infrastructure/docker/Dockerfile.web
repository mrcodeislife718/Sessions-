FROM node:22-alpine
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install
RUN pnpm exec tsc -b packages/shared packages/codevault-core packages/native-repository \
  && pnpm --filter @sessions/cli build \
  && node scripts/build-cli-distribution.mjs \
  && pnpm --filter @sessions/web build
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
CMD ["pnpm", "--filter", "@sessions/web", "start"]
