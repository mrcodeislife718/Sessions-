FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache docker-cli && corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/runner ./apps/runner
RUN pnpm install --frozen-lockfile --filter @sessions/runner... && pnpm --filter @sessions/runner build
ENV NODE_ENV=production
RUN addgroup -S sessions && adduser -S -G sessions sessions && mkdir -p /sessions-private-runner && chown -R sessions:sessions /sessions-private-runner /app
USER sessions
CMD ["pnpm", "--filter", "@sessions/runner", "start:private"]
