# Public endpoint
SESSIONS_DOMAIN=sessions.example.com

# PostgreSQL
POSTGRES_USER=sessions
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=sessions

# Redis
REDIS_PASSWORD=replace-with-a-long-random-secret

# Object storage
MINIO_ROOT_USER=sessions-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
S3_BUCKET=sessions

# API security / capacity
SESSIONS_MAX_BODY_BYTES=1048576
SESSIONS_RATE_LIMIT=300
SESSIONS_DB_POOL_MAX=20
# Production compose forces SESSIONS_ALLOW_INSECURE_LOCAL=false and derives CORS from SESSIONS_DOMAIN.

# Runner
RUNNER_POLL_MS=2000
