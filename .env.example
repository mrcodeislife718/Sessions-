# Local / Docker control plane
SESSIONS_API_URL=http://localhost:4000
NEXT_PUBLIC_SESSIONS_API_URL=http://localhost:4000
EXPO_PUBLIC_SESSIONS_API_URL=http://localhost:4000
SESSIONS_WEB_URL=http://localhost:3000/dashboard

# Storage / infrastructure
