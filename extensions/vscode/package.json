{
  "name": "sessions-vscode",
  "displayName": "Sessions",
  "description": "AI-native source control and execution visibility for AI systems, AI agents, and humans.",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.95.0" },
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "Sessions",
      "properties": {
        "sessions.apiUrl": {
          "type": "string",
          "default": "http://localhost:4000",
          "description": "Sessions control-plane API URL"
        }
      }
    },
    "commands": [
      { "command": "sessions.start", "title": "Sessions: Start Session" },
      { "command": "sessions.checkpoint", "title": "Sessions: Create Checkpoint" },
      { "command": "sessions.verify", "title": "Sessions: Verify Current State" },
      { "command": "sessions.timeline", "title": "Sessions: Open Timeline" },
      { "command": "sessions.rollback", "title": "Sessions: Roll Back" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "sessions", "title": "Sessions", "icon": "resources/icon.svg" }]
    },
    "views": {
      "sessions": [{ "id": "sessions.overview", "name": "Current Session" }]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.9.0"
  }
}
