{
  "name": "sessions-vscode",
  "displayName": "Sessions",
  "description": "Native development workflow, source control, verification, execution visibility, and recovery for humans and AI.",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.95.0" },
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "Sessions",
      "properties": {
        "sessions.apiUrl": {
          "type": "string",
          "default": "http://localhost:4000",
          "description": "Sessions control-plane API URL. Hosted tokens are stored separately in VS Code SecretStorage."
        }
      }
    },
    "commands": [
      { "command": "sessions.refresh", "title": "Sessions: Refresh" },
      { "command": "sessions.connectHosted", "title": "Sessions: Connect to Hosted Sessions" },
      { "command": "sessions.disconnectHosted", "title": "Sessions: Disconnect Hosted Sessions" },
      { "command": "sessions.billing", "title": "Sessions: Show Billing & Entitlement Status" },
      { "command": "sessions.start", "title": "Sessions: Start Session" },
      { "command": "sessions.stageAll", "title": "Sessions: Stage All Changes" },
      { "command": "sessions.unstageAll", "title": "Sessions: Unstage All Changes" },
      { "command": "sessions.checkpoint", "title": "Sessions: Create Checkpoint" },
      { "command": "sessions.switchWorkstream", "title": "Sessions: Switch Workstream" },
      { "command": "sessions.verify", "title": "Sessions: Verify Current State" },
      { "command": "sessions.integrity", "title": "Sessions: Verify Repository Integrity" },
      { "command": "sessions.timeline", "title": "Sessions: Open Timeline" },
      { "command": "sessions.rollback", "title": "Sessions: Prepare Recovery" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "sessions", "title": "Sessions", "icon": "resources/icon.svg" }]
    },
    "views": {
      "sessions": [{ "id": "sessions.overview", "name": "Source Control & Session" }]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@sessions/native-repository": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.9.0"
  }
}
